# このファイルは「必要なキーの名前の一覧」です。値は書かずに Git に入れます。
# 使い方: このファイルをコピーして .env を作り、.env のほうに本物の値を書き込みます。
#   Mac / Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# .env は .gitignore に入っているので GitHub には上がりません。AI にも読ませません。

# ── サーバー側だけで使う（接頭辞を付けない。ブラウザには配られない）──
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Supabase の secret キー（RLS を無視できる強い鍵。サーバー専用）
SUPABASE_SECRET_KEY=

# ── ブラウザに配られてもよい値（NEXT_PUBLIC_ / VITE_ などの接頭辞を付ける）──
# Supabase の URL と publishable キー（anon キー）。守りは RLS で行う
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
